POSTGRES_DB=esb_db
POSTGRES_USER=esb_admin
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql://esb_admin:change_me@postgres:5432/esb_db
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRY_DAYS=3650

PLUGINS_DIR=app/plugins
LOG_DIR=app/logs
AVIATION_DB_PATH=resources/synthetic_aviation_messages.db

LDAP_ENABLED=false
LDAP_SERVER=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN=cn=admin,dc=example,dc=com
LDAP_PASSWORD=change_me
LDAP_AUTH_ROUTE=/auth/ldap
LDAP_CALLBACK_ROUTE=/auth/ldap/callback

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC=app_logs
KAFKA_CONSUMER_GROUP=esb_consumer_group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_POLL_RECORDS=500
